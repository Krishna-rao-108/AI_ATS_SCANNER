# Prune AI Gateway Configuration
PRUNE_API_KEY=your_prune_api_key_here
PRUNE_BASE_URL=https://api.withprune.com/v1
PRUNE_MODEL=gemini-3.6-flash

# Backend Server Configuration
PORT=8000
HOST=127.0.0.1
PRUNE_TIMEOUT=90.0
PRUNE_MAX_RETRIES=1

# AWS Bedrock Proxy (Optional)
PRUNE_BEDROCK_URL=https://api.withprune.com/v1/proxy/bedrock/invoke
PRUNE_BEDROCK_MODEL=claude-sonnet-4-20250514
